{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qinglink.local/protocol/v2/ws",
  "title": "QingLink API v2 WebSocket envelope",
  "description": "Common envelope shared by the events and input WebSocket channels. Scanner catalog launch_mode uses the displayMode definition.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["type", "request_id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "launch_mode": { "$ref": "#/$defs/displayMode" },
        "clear_launch_mode": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "description": "错误帧把 {code, message} 放在 data 里，不存在顶层 error 键。服务端的 WsServerResponse 用 #[serde(tag = \"type\", content = \"data\")]，线格式由此固定；HTTP 契约用的是 {ok:false, error:{...}}，两者不可互换。",
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "error" } }
          },
          "then": {
            "required": ["data"],
            "properties": { "data": { "$ref": "#/$defs/error" } }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "displayMode": {
      "type": "object",
      "required": ["width", "height", "refresh_millihz"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "refresh_millihz": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "displayInfo": {
      "type": "object",
      "required": ["id", "name", "primary", "current_mode", "modes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "primary": { "type": "boolean" },
        "current_mode": { "$ref": "#/$defs/displayMode" },
        "modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/displayMode" }
        }
      },
      "additionalProperties": false
    },
    "displaysResponse": {
      "type": "object",
      "required": ["displays"],
      "properties": {
        "displays": {
          "type": "array",
          "items": { "$ref": "#/$defs/displayInfo" }
        }
      },
      "additionalProperties": false
    },
    "inputState": {
      "type": "object",
      "required": ["type", "left", "right", "middle"],
      "properties": {
        "type": { "const": "input_state" },
        "left": { "type": "boolean" },
        "right": { "type": "boolean" },
        "middle": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "launcherItemSummary": {
      "type": "object",
      "required": ["id", "name", "original_name", "exe_path", "category", "source"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "original_name": { "type": "string" },
        "exe_path": { "type": "string" },
        "category": { "type": "string" },
        "source": { "type": "string" },
        "launch_mode": { "$ref": "#/$defs/displayMode" }
      },
      "additionalProperties": true
    }
  }
}
