{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qinglink.local/protocol/v2/ws",
  "title": "QingLink API v2 WebSocket envelope",
  "description": "Common envelope shared by the events and input WebSocket channels.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["type", "request_id"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 },
        "data": { "type": "object" },
        "error": { "$ref": "#/$defs/error" }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
