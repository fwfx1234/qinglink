#include <windows.h>

// Application manifest: PerMonitorV2 DPI awareness, the Common-Controls 6.0
// dependency and an explicit execution level (see qinglink.exe.manifest).
// gpui's own manifest is disabled via the `windows-manifest` feature because a
// second RT_MANIFEST/1 resource cannot be linked (CVTRES CVT1100).
1 RT_MANIFEST "qinglink.exe.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904e4"
    BEGIN
      VALUE "CompanyName", "QingLink\0"
      VALUE "FileDescription", "QingLink Desktop\0"
      VALUE "FileVersion", "0.1.0.0\0"
      VALUE "InternalName", "QingLink.exe\0"
      VALUE "OriginalFilename", "QingLink.exe\0"
      VALUE "ProductName", "QingLink\0"
      VALUE "ProductVersion", "0.1.0.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1252
  END
END
