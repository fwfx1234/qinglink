<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <!--
    The desktop application manifest.  It mirrors what gpui normally embeds
    (`gpui/resources/windows/gpui.manifest.xml`: PerMonitorV2 DPI awareness +
    the Common-Controls 6.0 dependency) and adds an explicit execution level.
    gpui's own manifest is disabled via the `windows-manifest` feature because
    two RT_MANIFEST/1 resources cannot be linked into the same image
    (CVTRES CVT1100: duplicate resource MANIFEST/1).

    `requestedExecutionLevel` is declared so the process is never treated as an
    unmanifested legacy application (no UAC virtualization, launcher token
    instead of legacy heuristics).

    Keep this at `asInvoker`: QingLink does not require administrator rights.
    A process started by a low-integrity host remains low integrity and Windows
    will reject its notification-area registration; it must instead be started
    from the normal interactive desktop. The diagnostics in `src/tray` report
    both integrity levels.
  -->
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type='win32' name='Microsoft.Windows.Common-Controls' version='6.0.0.0' processorArchitecture='*' publicKeyToken='6595b64144ccf1df' />
    </dependentAssembly>
  </dependency>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
